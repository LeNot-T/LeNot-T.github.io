---
import Layout from "../layouts/Layout.astro";
import Intro from "../components/Intro.astro";
import Evidence from "../components/Evidence.astro";
import WaveDivider from "../components/WaveDivider.astro";
import Presentacion from "../components/Presentacion.astro";
import Socials from "../components/Socials.astro";
import Modelado from "../components/evidences/modelado.astro";
import Normalizacion from "../components/evidences/normalizacion.astro";
import Project from "../components/evidences/project.astro";

const variables = {
  name: "Alejandro Ferrer",
  subtitles:
    "Ingeniero, escritor, ser humano, interesado por contexto rebuscado en canciones y videojuegos de mundo abierto.",
};
---

<Layout title={variables.name}>
  <main>
    <Intro name={variables.name} subtitle={variables.subtitles} />
    <WaveDivider color="rosewater" speed={100} size={1.6} direction="left" />

    <Presentacion />
    <WaveDivider color="rosewater" speed={100} size={1.6} direction="left" />

    <Evidence />
    <WaveDivider color="rosewater" speed={100} size={1.6} direction="right" />
    <Modelado />
    <Normalizacion />
    <Project />
    
    <WaveDivider color="rosewater" speed={100} size={1.6} direction="right" />

    <Socials />
  </main>

  <div id="image-modal" class="image-modal">
    <img id="modal-img" />
  </div>

  <script type="module" client:load>
    import { setupLightbox } from "../scripts/lightbox.js";
    setupLightbox();
  </script>
</Layout>