---
const video = {
  title: "Presentación",
  description: "Conóceme",
  src: "/Presentacion.mp4",
};
---

<section class="video-section">
  <h2 class="section-title">{video.title}</h2>
  <p class="video-description">{video.description}</p>

  <div class="video-wrapper">
    <video
      controls
      preload="metadata"
      src={video.src}
    ></video>
  </div>
</section>

<style>
  .video-wrapper video {
    width: 100%;
    height: 100%;
    border-radius: 16px;
  }
</style>