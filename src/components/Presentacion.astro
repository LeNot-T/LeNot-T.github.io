---
const video = {
  title: "Presentación",
  description: "Conóceme",
  src: "/Presentacion.mp4",
};
---

<section class="video-section">
  <h2 class="section-title">{video.title}</h2>
  <p class="video-description">{video.description}</p>

  <div class="video-wrapper">
    <video
      controls
      preload="metadata"
      src={video.src}
    ></video>
  </div>
</section>

<style>
  .video-section {
  max-width: 900px;
  margin: 6rem auto;
  padding: 0 2rem;
  text-align: center;
}

.video-wrapper {
  position: relative;
  width: 100%;
  max-width: 720px;
  aspect-ratio: 16 / 9;
  margin: 0 auto;
  border-radius: 16px;
  overflow: hidden;
  background: var(--ctp-surface0);
}

.video-wrapper video {
  width: 100%;
  height: 100%;
  display: block;
}
</style>