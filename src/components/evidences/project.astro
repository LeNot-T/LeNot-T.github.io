---
const evidences = [
  {
    title: "Que Boleteo.com",
    description: `QueBoleteo es un proyecto donde se apunta a crear una plataforma 
    centralizada de venta de boletos para conciertos a nivel nacional, haciendo uso 
    de Modelos-Entidad Relación, Modelos-Entidad Relación Extendidos, Reducción a Tablas, 
    modelos relacionales, base de datos relacional por medio de máquina virtual, backend 
    con Springboot App y frontend con Angular.`,
    image: "/evidence/QueBoleteo - Logo.png",
    link: "https://drive.google.com/drive/folders/1BxqBUpjdP8crR8-iwh79I1YA4hHIWS-z?usp=sharing",
    github: "https://github.com/Juan-0RBE/QueBoleteo_Project_Database"
  },
];
---

<section id="project" class="evidence-section">
  <h3>Proyecto</h3>

  <div class="evidence-grid">
    {evidences.map((item) => (
      <article class="evidence-card">
  <div class="image-wrapper" data-image={item.image}>
    <img src={item.image} alt={item.title} />
  </div>
  <h4>{item.title}</h4>
  <p>{item.description}</p>
  {
  item.link && (
    <a
      href={item.link}
      class="evidence-button"
      target="_blank"
      rel="noopener noreferrer"
    >
      Ver documentación.
    </a>
  )
}
  {
  item.github && (
    <a
      href={item.github}
      class="github-button"
      target="_blank"
      rel="noopener noreferrer"
    >
      <svg
  class="github-icon"
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill="currentColor"
>
  <path d="M12 .5C5.65.5.5 5.65.5 12a11.5 11.5 0 008 10.95c.6.1.82-.26.82-.58v-2.03c-3.25.71-3.94-1.57-3.94-1.57-.53-1.34-1.3-1.7-1.3-1.7-1.06-.73.08-.72.08-.72 1.17.08 1.78 1.2 1.78 1.2 1.04 1.78 2.72 1.27 3.39.97.1-.76.4-1.27.72-1.56-2.6-.3-5.34-1.3-5.34-5.8 0-1.28.46-2.33 1.2-3.15-.12-.3-.52-1.52.12-3.17 0 0 .98-.31 3.2 1.2a11.1 11.1 0 015.82 0c2.22-1.51 3.2-1.2 3.2-1.2.64 1.65.24 2.87.12 3.17.75.82 1.2 1.87 1.2 3.15 0 4.51-2.74 5.5-5.35 5.79.42.36.79 1.08.79 2.18v3.23c0 .32.21.69.83.58A11.5 11.5 0 0023.5 12C23.5 5.65 18.35.5 12 .5z"/>
</svg>
      <span class="github-text">
        Ver repositorio
      </span>
    </a>
  )
}
</article>
    ))}
  </div>
</section>

<style>
  .evidence-section {
    max-width: 900px;
    margin: 6rem auto;
    padding: 0 2rem;
  }

  .evidence-section h3 {
    text-align: center;
    font-size: 1.75rem;
    margin-bottom: 3rem;
    color: var(--ctp-text);
    font-family: "Jacquard 24", system-ui, sans-serif;
  }

  .evidence-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 2rem;
  }

  .evidence-card {
    background-color: var(--ctp-surface0);
    border-radius: 14px;
    padding: 1.5rem;
    text-align: center;
  }

  .evidence-card img {
  width: 100%;
  max-width: 100%;
  height: auto;
  border-radius: 10px;
  display: block;
}

  .evidence-card h4 {
    margin-bottom: 0.5rem;
    font-size: 1.1rem;
  }

  .evidence-card p {
    font-size: 0.95rem;
    opacity: 0.85;
  }

  .image-wrapper {
    cursor: zoom-in;
  }

.evidence-button {
  display: inline-block;
  margin-top: 1rem;
  padding: 0.75rem 1.25rem;
  border-radius: 10px;
  background-color: var(--ctp-lavender);
  color: var(--ctp-base);
  text-decoration: none;
  font-weight: 600;
  transition: all 0.25s ease;
}

.evidence-button:hover {
  transform: translateY(-2px);
  opacity: 0.9;
}

.github-button {
  margin-top: 1rem;

  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;

  gap: 0.5rem;

  padding: 1rem;

  border-radius: 12px;

  background-color: #171515;
  color: white;

  text-decoration: none;

  transition: all 0.25s ease;
}

.github-button:hover {
  transform: translateY(-3px);
  opacity: 0.92;
}

.github-icon {
  width: 42px;
  height: 42px;
}

.github-text {
  font-size: 0.95rem;
  font-weight: 600;
}
</style>