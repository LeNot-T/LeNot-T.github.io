<section id="modelado" class="evidence-section">
  <h3>Modelado</h3>

  <div class="evidence-grid">
    {evidences.map((item) => (
      <article class="evidence-card">
  <div class="image-wrapper" data-image={item.image}>
    <img src={item.image} alt={item.title} />
  </div>
  <h4>{item.title}</h4>
  <p>{item.description}</p>
  {
  item.link && (
    <a
      href={item.link}
      class="evidence-button"
      target="_blank"
      rel="noopener noreferrer"
    >
      Acceda aquí
    </a>
  )
}
</article>
    ))}
  </div>

  <div id="image-modal" class="modal">
    <span class="close">&times;</span>
    <img id="modal-img" />
  </div>
</section>

<style>
  .evidence-section {
    max-width: 900px;
    margin: 6rem auto;
    padding: 0 2rem;
  }

  .evidence-section h3 {
    text-align: center;
    font-size: 1.75rem;
    margin-bottom: 3rem;
    color: var(--ctp-text);
    font-family: "Jacquard 24", system-ui, sans-serif;
  }

  .evidence-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 2rem;
  }

  .evidence-card {
    background-color: var(--ctp-surface0);
    border-radius: 14px;
    padding: 1.5rem;
    text-align: center;
  }

  .evidence-card img {
  width: 100%;
  max-width: 100%;
  height: auto;
  border-radius: 10px;
  display: block;
}

  .evidence-card h4 {
    margin-bottom: 0.5rem;
    font-size: 1.1rem;
  }

  .evidence-card p {
    font-size: 0.95rem;
    opacity: 0.85;
  }
  .image-wrapper {
    cursor: zoom-in;
  }

  .modal {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.85);
  display: none;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal.open {
  display: flex;
}

.modal img {
  max-width: 90%;
  max-height: 90%;
  border-radius: 12px;
}

.modal .close {
  position: absolute;
  top: 1.5rem;
  right: 2rem;
  font-size: 2rem;
  color: white;
  cursor: pointer;
}

.evidence-button {
  display: inline-block;
  margin-top: 1rem;
  padding: 0.75rem 1.25rem;
  border-radius: 10px;
  background-color: var(--ctp-lavender);
  color: var(--ctp-base);
  text-decoration: none;
  font-weight: 600;
  transition: all 0.25s ease;
}

.evidence-button:hover {
  transform: translateY(-2px);
  opacity: 0.9;
}
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const modal = document.getElementById("image-modal");
    const modalImg = document.getElementById("modal-img");
    const closeBtn = document.querySelector(".modal .close");

    if (!modal || !modalImg || !closeBtn) return;

    document.addEventListener("click", (e) => {
      const wrapper = e.target.closest(".image-wrapper");
      if (!wrapper) return;

      modalImg.src = wrapper.dataset.image;
      modal.classList.add("open");
    });

    closeBtn.addEventListener("click", () => {
      modal.classList.remove("open");
    });

    modal.addEventListener("click", (e) => {
      if (e.target === modal) modal.classList.remove("open");
    });
  });
</script>