---
const evidences = [
  {
    title: "Modelo Relacional",
    description: "Del ejercicio de Biblioteca",
    image: "/evidence/MR Biblioteca.jpg",
  },
  {
    title: "Modelo Relacional",
    description: "Del ejercicio de Hospital",
    image: "/evidence/MR Hospital.jpg",
  },
];
---

<section id="modelado" class="evidence-section">
  <h3>Modelado</h3>

  <div class="evidence-grid">
    {evidences.map((item) => (
      <article class="evidence-card">
  <div class="image-wrapper" onclick={`openImage('${item.image}')`}>
  <img src={item.image} alt={item.title} />
</div>
  <div id="image-modal" class="image-modal">
    <img id="modal-img" />
  </div>
  <h4>{item.title}</h4>
  <p>{item.description}</p>
</article>
    ))}
  </div>
</section>

<script>
  import { setupLightbox } from "../scripts/lightbox.js";
  setupLightbox();
</script>

<style>
  .evidence-section {
    max-width: 900px;
    margin: 6rem auto;
    padding: 0 2rem;
  }

  .evidence-section h3 {
    text-align: center;
    font-size: 1.75rem;
    margin-bottom: 3rem;
    color: var(--ctp-text);
    font-family: "Jacquard 24", system-ui, sans-serif;
  }

  .evidence-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 2rem;
  }

  .evidence-card {
    background-color: var(--ctp-surface0);
    border-radius: 14px;
    padding: 1.5rem;
    text-align: center;
  }

  .evidence-card img {
  width: 100%;
  max-width: 100%;
  height: auto;
  border-radius: 10px;
  display: block;
}

  .evidence-card h4 {
    margin-bottom: 0.5rem;
    font-size: 1.1rem;
  }

  .evidence-card p {
    font-size: 0.95rem;
    opacity: 0.85;
  }

  .image-modal {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.85);
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.2s ease;
  z-index: 999;
}

.image-modal.active {
  opacity: 1;
  pointer-events: auto;
}

.image-modal img {
  max-width: 90%;
  max-height: 90%;
  border-radius: 14px;
}
</style>