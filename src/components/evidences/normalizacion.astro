---
const evidences = [
  {
    title: "Taller Normalización",
    description: `En este taller se nos presentó con la tarea de realizar el respectivo proceso 
    de normalización a tablas, desde Primera Forma Normal hasta Tercera Forma Normal.`,
    image: "/evidence/Evidence-placeholder.jpg",
    link1: "https://drive.google.com/file/d/1VROzs_ZzD-qhI0WWjMe1WY2FxMm9TgKi/view?usp=sharing",
    link2: "https://unbosqueeduco-my.sharepoint.com/:x:/g/personal/pferrerc_unbosque_edu_co/IQBuDjRJ3h-VSYDnuxl9Px7nAZ4zRaZ3xuctwB42x2vmg1c?e=dANgtN"
  },
];
---

<section id="normalizacion" class="evidence-section">
  <h3>Normalización</h3>

  <div class="evidence-grid">
  {evidences.map((item) => (
    <article class="evidence-card">

      <div class="image-wrapper" data-image={item.image}>
        <img src={item.image} alt={item.title} />
      </div>

      <h4>{item.title}</h4>
      <p>{item.description}</p>

      {
        item.link1 && (
          <a
            href={item.link1}
            class="evidence-button"
            target="_blank"
            rel="noopener noreferrer"
          >
            Acceda a información aquí
          </a>
        )
      }

      {
        item.link2 && (
          <a
            href={item.link2}
            class="evidence-button"
            target="_blank"
            rel="noopener noreferrer"
          >
            Acceda a desarrollo aquí
          </a>
        )
      }

    </article>
  ))}
</div>
</section>

<style>
  .evidence-section {
    max-width: 900px;
    margin: 6rem auto;
    padding: 0 2rem;
  }

  .evidence-section h3 {
    text-align: center;
    font-size: 1.75rem;
    margin-bottom: 3rem;
    color: var(--ctp-text);
    font-family: "Jacquard 24", system-ui, sans-serif;
  }

  .evidence-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 2rem;
  }

  .evidence-card {
    background-color: var(--ctp-surface0);
    border-radius: 14px;
    padding: 1.5rem;
    text-align: center;
  }

  .evidence-card img {
  width: 100%;
  max-width: 100%;
  height: auto;
  border-radius: 10px;
  display: block;
}

  .evidence-card h4 {
    margin-bottom: 0.5rem;
    font-size: 1.1rem;
  }

  .evidence-card p {
    font-size: 0.95rem;
    opacity: 0.85;
  }

  .image-wrapper {
    cursor: zoom-in;
  }
</style>